workDir = "/rds/general/user/${System.getenv('USER')}/ephemeral/NEXTFLOW/"
singularity.autoMounts = true
singularity.cacheDir="/rds/general/user/${System.getenv('USER')}/ephemeral/NEXTFLOW/"


manifest {
    name = 'johnsonlab-ic/sceQTL-flow'
    author = 'Alexander Haglund <a.haglund@imperial.ac.uk>'
    description = 'A Nextflow pipeline for single-cell expression Quantitative Trait Loci analysis'
    version = '1.0.0'
    nextflowVersion = '>=20.10.0'
}

report {
    enabled = true
    file = "${baseDir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${baseDir}/pipeline_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${baseDir}/pipeline_dag.dot"
    overwrite = true
}

workflow.onComplete = {
    def reportLine = params.report ?
        "eQTL report generated at: ${params.outdir}/eQTL_outputs/eqtl_report.html" :
        "Report skipped (--report false). eQTL outputs in: ${params.outdir}/eQTL_outputs/"
    println """
    ========================================
    Pipeline Completed!
    ========================================

    ${reportLine}

    """
}

params {
    // Default covariates setting
    covariates_to_include = "all"
}

profiles {
    
    offline {

        docker.enabled=true
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'

        process {

            executor = "local"
            maxForks = 2

            // Default: everything runs in the unified genetics image
            container = "ghcr.io/johnsonlab-ic/genetics:latest"

            // Single-cell only: pseudobulk + overlap need the heavy Seurat/scanpy stack
            withName: /pseudobulk_anndata|pseudobulk_seurat|check_overlap/ {
                container = "ghcr.io/johnsonlab-ic/landmark-sc_image:latest"
            }
        }
    }

    imperial {

        docker.enabled = false
        singularity.enabled = true


        process {
            executor = 'pbspro'
            // Default: everything runs in the unified genetics image
            container = "docker://ghcr.io/johnsonlab-ic/genetics:latest"

            // Single-cell only: pseudobulk + overlap need the heavy Seurat/scanpy stack
            withName: /pseudobulk_anndata|pseudobulk_seurat|check_overlap/ {
                container = "docker://ghcr.io/johnsonlab-ic/landmark-sc_image:latest"
            }

            // General resource requirements
            errorStrategy = 'retry'
            maxRetries = 5
            maxErrors = '-1'
            queue = { 4 * task.attempt > 8 ? 'v1_small24' : 'v1_small24' }
            cpus = { 1 * task.attempt }
            memory = { 6.GB * task.attempt }
            time = { 4.h * task.attempt }

            // Process-specific resource requirements
            withLabel:process_single {
                cpus = 1
                memory = { 6.GB * task.attempt }
                time = { 4.h * task.attempt }
            }

            withLabel:process_low {
                cpus = { 2 * task.attempt }
                memory = { 12.GB * task.attempt }
                time = { 2.h * task.attempt }
            }

            withLabel:process_medium {
                queue = 'v1_medium24'
                cpus = { 9 * task.attempt }
                memory = { 36.GB * task.attempt }
                time = { 9.h * task.attempt }
            }

            withLabel:process_high {
                queue = 'v1_medium24'
                cpus = { 12 * task.attempt }
                memory = { 72.GB * task.attempt }
                time = { 1.h * task.attempt }
            }

            withLabel:process_long {
                queue = 'v1_medium24'
                cpus = 9
                memory = 96.GB
                time = { 14.h * task.attempt }
            }

            withLabel:process_eqtl {
                queue = { 200 * task.attempt < 921 ? 'v1_medium24' : 'v1_largemem24' }
                cpus = {20 * task.attempt }
                memory = { 300.GB * task.attempt }
                time = { 0.5.h * task.attempt }
            }

            withLabel:process_high_memory {
                queue = { 200 * task.attempt < 921 ? 'v1_medium24' : 'v1_largemem24' }
                cpus = { 10 * task.attempt }
                memory = { 200.GB * task.attempt }
                time = { 4.h * task.attempt }
            }
        }
    }
}